{
  "name": "airtulip-theme",
  "private": true,
  "description": "Shopify Online Store theme for airtulip.com (Concept / RoarTheme)",
  "scripts": {
    "dev": "npm run storefront",
    "storefront": "node scripts/storefront.mjs",
    "pull": "shopify theme pull --store=airtulip.myshopify.com",
    "storefront:dry-run": "node scripts/storefront.mjs --dry-run",
    "storefront:unattended": "node scripts/storefront.mjs --unattended"
  },
  "engines": {
    "node": "22.23.1"
  },
  "devDependencies": {
    "@shopify/cli": "4.9.0"
  }
}
