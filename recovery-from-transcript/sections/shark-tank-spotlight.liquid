<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .shark-spotlight {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
    padding: clamp(var(--sp-6), 4vw, var(--sp-10));
    border-radius: var(--rounded-block);
    background: var(--gradient-background, rgb(var(--color-background)));
    background-color: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-border));
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .shark-spotlight {
      grid-template-columns: auto 1fr;
      gap: clamp(var(--sp-6), 4vw, var(--sp-12));
    }
  }

  #shopify-section-{{ section.id }} .shark-spotlight__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, {{ section.settings.logo_max_width }}px);
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .shark-spotlight__logo img {
    width: 100%;
    height: auto;
    max-height: {{ section.settings.logo_max_height }}px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .shark-spotlight__eyebrow {
    margin: 0 0 var(--sp-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground) / 0.65);
  }

  #shopify-section-{{ section.id }} .shark-spotlight__heading {
    margin: 0 0 var(--sp-3);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .shark-spotlight__heading-line {
    display: inline;
    background-image: linear-gradient(rgb(var(--color-foreground)), rgb(var(--color-foreground)));
    background-size: 100% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-block-end: 0.12em;
  }

  #shopify-section-{{ section.id }} .shark-spotlight__text {
    margin: 0 0 var(--sp-5);
    max-width: 52ch;
    font-size: var(--text-base);
    line-height: 1.6;
    color: rgb(var(--color-foreground) / 0.82);
  }

  #shopify-section-{{ section.id }} .shark-spotlight__proof {
    display: grid;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-6);
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .shark-spotlight__proof {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-4);
    }
  }

  #shopify-section-{{ section.id }} .shark-spotlight__proof li {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: rgb(var(--color-foreground) / 0.88);
  }

  #shopify-section-{{ section.id }} .shark-spotlight__proof .icon {
    flex-shrink: 0;
    margin-block-start: 0.15em;
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .shark-spotlight__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <motion-list class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %} relative block">
    <div class="shark-spotlight">
      {%- if section.settings.logo != blank -%}
        <motion-element class="shark-spotlight__logo block" data-animate="fade-up" data-animate-delay="0">
          {%- if section.settings.episode_url != blank -%}
            <a href="{{ section.settings.episode_url }}" class="block"{% if section.settings.episode_external %} target="_blank" rel="noopener"{% endif %}>
          {%- endif -%}
          {{- section.settings.logo | image_url: width: 480 | image_tag: loading: 'lazy', widths: '160,240,320,480', sizes: '(max-width: 767px) 200px, 240px', alt: section.settings.logo.alt | default: 'Shark Tank' | escape -}}
          {%- if section.settings.episode_url != blank -%}
            </a>
          {%- endif -%}
        </motion-element>
      {%- endif -%}

      <div class="shark-spotlight__body">
        {%- if section.settings.eyebrow != blank -%}
          <motion-element class="block" data-animate="fade-up" data-animate-delay="50">
            <p class="shark-spotlight__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          </motion-element>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <motion-element class="block" data-animate="fade-up" data-animate-delay="100">
            <{{ section.settings.heading_tag }} class="shark-spotlight__heading heading">
              <span class="shark-spotlight__heading-line">{{ section.settings.heading | escape }}</span>
            </{{ section.settings.heading_tag }}>
          </motion-element>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <motion-element class="block" data-animate="fade-up" data-animate-delay="150">
            <motion-element class="shark-spotlight__text rte" data-animate="fade-up" data-animate-delay="150">
              {{- section.settings.text -}}
            </motion-element>
          </motion-element>
        {%- endif -%}

        {%- if section.settings.proof_1 != blank or section.settings.proof_2 != blank or section.settings.proof_3 != blank -%}
          <motion-element class="block" data-animate="fade-up" data-animate-delay="200">
            <ul class="shark-spotlight__proof" role="list">
              {%- for i in (1..3) -%}
                {%- case i -%}
                  {%- when 1 -%}{%- assign proof = section.settings.proof_1 -%}
                  {%- when 2 -%}{%- assign proof = section.settings.proof_2 -%}
                  {%- when 3 -%}{%- assign proof = section.settings.proof_3 -%}
                {%- endcase -%}
                {%- if proof != blank -%}
                  <li>
                    {%- render 'icon', icon: 'check_mark', size: 'sm' -%}
                    <span>{{ proof | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </motion-element>
        {%- endif -%}

        <motion-element class="shark-spotlight__actions" data-animate="fade-up" data-animate-delay="250">
          {%- if section.settings.button_label != blank -%}
            {%- render 'button',
              label: section.settings.button_label,
              link: section.settings.episode_url,
              size: 'md',
              style: 'primary',
              external: section.settings.episode_external,
              show_icon: section.settings.button_icon
            -%}
          {%- endif -%}
          {%- if section.settings.button_secondary_label != blank -%}
            {%- render 'button',
              label: section.settings.button_secondary_label,
              link: section.settings.button_secondary_link,
              size: 'md',
              style: 'secondary',
              external: section.settings.button_secondary_external,
              show_icon: false
            -%}
          {%- endif -%}
        </motion-element>
      </motion-element>
    </motion-element>
  </motion-list>
</motion-element>

{% schema %}
{
  "name": "Shark Tank spotlight",
  "tag": "section",
  "class": "shopify-section--shark-tank-spotlight",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Shark Tank logo"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 200,
      "label": "Logo max width"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 48,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72,
      "label": "Logo max height"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "As seen on Shark Tank"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The pitch that put bedside clean air on national TV"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2",
      "label": "Heading tag"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Supporting text",
      "default": "<p>Millions watched our founders present AirTulip Sleep on <strong>Shark Tank</strong>—a headboard that delivers filtered, laminar air where you breathe at night. Watch the segment and see why shoppers compare us to every floor purifier they have owned.</p>"
    },
    {
      "type": "text",
      "id": "proof_1",
      "label": "Proof point 1",
      "default": "National TV validation for a four-figure sleep investment"
    },
    {
      "type": "text",
      "id": "proof_2",
      "label": "Proof point 2",
      "default": "Founder story: engineered for sleep, not showroom CFM"
    },
    {
      "type": "text",
      "id": "proof_3",
      "label": "Proof point 3",
      "default": "Stream the full episode in minutes"
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Watch the Shark Tank segment"
    },
    {
      "type": "url",
      "id": "episode_url",
      "label": "Episode link"
    },
    {
      "type": "checkbox",
      "id": "episode_external",
      "label": "Open episode link in new tab",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "button_icon",
      "label": "Show arrow icon on primary button",
      "default": true
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Secondary button label",
      "default": "Watch on Hulu"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "button_secondary_external",
      "label": "Open secondary link in new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Narrow content width",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#f8f7f6"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "Background gradient"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Padding bottom"
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show section divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "label": "Rounded section",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Shark Tank spotlight"
    }
  ]
}
{% endschema %}
