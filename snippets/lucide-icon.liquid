{%- doc -%}
  Renders Lucide icons (MIT, https://lucide.dev).
  Source: https://github.com/lucide-icons/lucide

  @param {string} icon - Icon key (schema value or Lucide name)
  @param {number} [width] - Width and height in px
  @param {string} [class] - Additional CSS classes
{%- enddoc -%}

{%- liquid
  assign lucide_size = width | default: 24
  assign lucide_class = class | default: '' | append: ' lucide-icon' | strip

  case icon
    when 'headphone'
      assign lucide_name = 'headphones'
    when 'planet', 'planet_2'
      assign lucide_name = 'globe'
    when 'recycling'
      assign lucide_name = 'recycle'
    when 'check_mark'
      assign lucide_name = 'circle-check'
    when 'lightning'
      assign lucide_name = 'zap'
    when 'support'
      assign lucide_name = 'life-buoy'
    when 'time'
      assign lucide_name = 'clock'
    when 'headphones', 'globe', 'recycle', 'circle-check', 'zap', 'life-buoy', 'clock', 'wind', 'air-vent', 'funnel', 'volume-x', 'layers', 'moon', 'focus', 'target', 'shield-check'
      assign lucide_name = icon
    else
      assign lucide_name = icon
  endcase
-%}

