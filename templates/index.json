          }
        },
        "text_48CaxT": {
          "type": "text",
          "settings": {
            "text": "<p>Did you know standard air purifiers just mix clean air back into the dirty air already in your room? AirTulip Sleep is different. It is the only product on the market designed to completely bypass \"mixed air.\" </p><p>Featuring a revolutionary <strong>laminar flow headboard design</strong>, it delivers a flawless, direct stream of 100% pure air over you while you rest. Stop breathing recycled room air and experience the market's only true pure-air sleep zone.</p>",
            "text_size": "subtext-md"
          }
        },
        "icon_row_split": {
          "type": "icon_row",
          "settings": {
            "icon_1_theme": "funnel",
            "icon_1": "shopify://shop_images/airtulip_hepa_filters_2.svg",
            "icon_1_alt": "",
            "label_1": "HEPA H14 filtration",
            "sub_1": "Dual filters capture ultrafine particles at your pillow",
            "icon_2_theme": "volume-x",
            "icon_2": "shopify://shop_images/airtulip_whisper_quiet_icon_ccfd8287-c71a-4476-b916-1cfe518f516a.svg",
